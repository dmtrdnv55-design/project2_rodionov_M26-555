[14.507449, "o", "***Процесс работы с таблицей***\r\nФункции:\r\n<command> list_tables - показать список всех таблиц\r\n<command> create_table <имя_таблицы> <столбец:тип> ... - создать таблицу\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n"]
[14.507741, "o", "<command> insert into <имя_таблицы> values (<значение1>, <значение2>, ...) — добавить запись\r\n<command> select from <имя_таблицы> — показать все записи\r\n<command> select from <имя_таблицы> where <столбец> = <значение> — найти записи\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение> — обновить записи\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> — удалить записи\r\n<command> info <имя_таблицы> — показать структуру и количество записей\r\n<command> exit - выйти из программы\r\n<command> help - справочная информация\r\nТипы значений: числа — 30, строки — \"Alex\", логические — true или false.\r\nID создаётся автоматически, передавать его в insert не нужно.\r\n"]
[14.511451, "o", "Введите команду: "]
[25.452041, "o", "create_table final_demo name:str age:int"]
[26.112969, "o", "\r\n"]
[26.113599, "o", "Таблица \"final_demo\" успешно создана со столбцами: ID:int, name:str, age:int\r\n"]
[26.139132, "o", "Введите команду: "]
[36.370795, "o", "insert into final_demo values (\"Alex\", 30)"]
[37.033856, "o", "\r\n"]
[37.036879, "o", "Функция insert выполнилась за 0.002 секунд.\r\n"]
[37.049386, "o", "Запись успешно добавлена в таблицу \"final_demo\"\r\n"]
[37.053155, "o", "Введите команду: "]
[44.26977, "o", "insert into final_demo values (\"Alex\", \"тридцать\")"]
[44.953223, "o", "\r\n"]
[44.953964, "o", "Ошибка валидации: Для столбца age требуется тип данных int\r\n"]
[44.960095, "o", "Введите команду: "]
[52.841395, "o", "select from final_demo"]
[53.467687, "o", "\r\n"]
[53.47413, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[54.468429, "o", "+----+------+-----+\r\n| ID | name | age |\r\n+----+------+-----+\r\n| 1  | Alex |  30 |\r\n+----+------+-----+\r\n"]
[54.470761, "o", "Введите команду: "]
[60.816101, "o", "select from final_demo"]
[61.407131, "o", "\r\n"]
[61.413207, "o", "+----+------+-----+\r\n| ID | name | age |\r\n+----+------+-----+\r\n| 1  | Alex |  30 |\r\n+----+------+-----+\r\n"]
[61.416161, "o", "Введите команду: "]
[69.863144, "o", "update final_demo set age = 31 where name = \"Alex\""]
[70.437511, "o", "\r\n"]
[70.445107, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[70.457486, "o", "Обновление таблицы \"final_demo\" выполнено\r\n"]
[70.465623, "o", "Введите команду: "]
[80.397353, "o", "select from final_demo"]
[80.915877, "o", "\r\n"]
[80.92399, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[80.924573, "o", "+----+------+-----+\r\n| ID | name | age |\r\n+----+------+-----+\r\n| 1  | Alex |  31 |\r\n+----+------+-----+\r\n"]
[80.930789, "o", "Введите команду: "]
[88.578021, "o", "delete from final_demo where name = \"Alex\""]
[89.348846, "o", "\r\n"]
[89.356965, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[90.524202, "o", "т"]
[91.233151, "o", "\b \b"]
[92.556308, "o", "n"]
[93.3111, "o", "\r\n"]
[93.311703, "o", "Операция отменена\r\n"]
[93.3175, "o", "Введите команду: "]
[101.813367, "o", "select from final_demo"]
[102.361996, "o", "\r\n"]
[102.370782, "o", "+----+------+-----+\r\n| ID | name | age |\r\n+----+------+-----+\r\n| 1  | Alex |  31 |\r\n+----+------+-----+\r\n"]
[102.37538, "o", "Введите команду: "]
[111.07634, "o", "delete from final_demo where name = \"Alex\""]
[111.60295, "o", "\r\n"]
[111.610899, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[115.690237, "o", "y"]
[116.368201, "o", "\r\n"]
[116.368739, "o", "Функция select выполнилась за 0.000 секунд.\r\n"]
[116.377558, "o", "Удаление записей из таблицы \"final_demo\" выполнено\r\n"]
[116.380916, "o", "Введите команду: "]
[126.399766, "o", "info final_demo"]
[127.173803, "o", "\r\n"]
[127.179848, "o", "Таблица: final_demo\r\nСтолбцы: ID:int, name:str, age:int\r\nКоличество записей: 0\r\n"]
[127.183555, "o", "Введите команду: "]
[137.20149, "o", "drop_table final_demo"]
[137.852095, "o", "\r\n"]
[137.852548, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[139.212318, "o", "y"]
[139.802718, "o", "\r\n"]
